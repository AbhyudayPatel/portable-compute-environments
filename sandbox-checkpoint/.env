# sandbox-checkpoint configuration (copy to .env to override)

# Host port for the checkpoint API
CHECKPOINT_PORT=9040

# Where sandbox-api is reachable FROM INSIDE the compose network we join
SANDBOX_API_URL=http://api:8000

# Blob store for shipping layers off the node (empty = keep layers on the
# node only; forks/restores still work, import does not)
BLOBS_URL=http://blobs:8000
