# Linux desktop environment configuration.
# Copy to .env (scripts/start.ps1 does this automatically) and adjust.

# --- Linux desktop (browser GUI) ---
DESKTOP_PORT=8080
DESKTOP_TITLE=Company Linux Desktop
# Leave empty for no password on localhost. Set one to require HTTP basic
# auth (username: abc) before the desktop loads.
DESKTOP_PASSWORD=

# Container user id mapping (911 is the linuxserver default)
PUID=911
PGID=911
TZ=Etc/UTC

# Git identity used for commits made inside the desktop
GIT_USER_NAME=Company Developer
GIT_USER_EMAIL=dev@company.local

# --- Application ---
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- Database ---
DB_PORT=5432
POSTGRES_PASSWORD=company
