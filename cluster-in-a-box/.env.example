# cluster-in-a-box configuration (copy to .env to override)
CLUSTER_PORT=9430
SANDBOX_API_URL=http://api:8000
WORKER_HOST=dind
# worker k: API at WORKER_API_BASE+k, identity ports WORKER_POOL_BASE+10k .. +9
WORKER_API_BASE=9340
WORKER_POOL_BASE=9300
WORKER_POOL_SIZE=10
MAX_WORKERS=4
WORKER_MAX_SANDBOXES=6
# heartbeat every N s; SUSPECT after 3 misses, DEAD after 5
HEARTBEAT_INTERVAL=2
SUSPECT_MISSES=3
DEAD_MISSES=5
