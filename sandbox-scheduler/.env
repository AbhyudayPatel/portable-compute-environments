# sandbox-scheduler configuration (copy to .env to override)

# Host port for the scheduler API + console
API_PORT=9010

# Where to find the T01 sandbox-api (must be running)
SANDBOX_API_URL=http://host.docker.internal:9000

# Cluster model the scheduler is allowed to use
CLUSTER_CPU_UNITS=4        # abstract CPU budget; each job spends units
MAX_SCHED_SANDBOXES=8      # hard cap on scheduler-owned sandboxes
MAX_QUEUE=50               # queue bound: beyond -> 429 (never unbounded RAM)
MAX_PER_TENANT=3           # noisy-neighbor cap: concurrent sandboxes per tenant

# Aging: a queued job gains +1 effective priority every AGING_INTERVAL
# seconds, up to +AGING_MAX_BONUS. Guarantees bounded wait (no starvation).
AGING_INTERVAL=5
AGING_MAX_BONUS=6

# Loop cadences (seconds)
PLACER_INTERVAL=1
MONITOR_INTERVAL=2
JANITOR_INTERVAL=3

# Max seconds a task-kind job's command may run inside its sandbox
JOB_TASK_TIMEOUT=60
