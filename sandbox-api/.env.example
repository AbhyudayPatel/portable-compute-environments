# sandbox-api (v2) port + limit configuration (copy to .env to override)

# Host port for the REST API + console
API_PORT=9000

# Identity port range for sandbox apps.
# Inner published port P == dind port P == localhost:P
POOL_START=9200
POOL_END=9209

# Hard cap on simultaneously existing sandboxes (engine-derived)
MAX_SANDBOXES=12

# Seconds between TTL-reaper sweeps / full engine<->DB resyncs
REAPER_INTERVAL=5
RESYNC_INTERVAL=30

# Default isolation for new sandboxes: container (runc) | gvisor (runsc)
DEFAULT_ISOLATION=container

# Token protecting privileged node operations on the engine (/node/*).
# Never published outside the compose network; change it anyway.
SBX_NODE_TOKEN=change-me-node-token
