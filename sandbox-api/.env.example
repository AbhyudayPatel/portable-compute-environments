# sandbox-api port + limit configuration (copy to .env to override)

# Host port for the REST API
API_PORT=9000

# Identity port range for sandbox apps.
# Inner published port P == dind port P == localhost:P
POOL_START=9200
POOL_END=9209

# Hard cap on simultaneously existing sandboxes (engine-derived)
MAX_SANDBOXES=12

# Seconds between TTL-reaper sweeps
REAPER_INTERVAL=5
