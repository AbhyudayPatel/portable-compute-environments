# sandbox-blobs configuration (copy to .env to override)

# Host port for the blob API
BLOBS_PORT=9400

# Largest accepted blob (bytes); uploads beyond this get 413
MAX_BLOB_BYTES=8589934592

# GC never deletes a blob written less than this many seconds ago, so an
# uploader always has time to register a reference after PUT
GC_GRACE_SECONDS=60
